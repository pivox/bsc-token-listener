{
  "name": "bsc-token-listener-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "rpc:check": "tsx scripts/check-rpc.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "deploy:probe": "tsx scripts/deploy-safety-probe.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "solc": "^0.8.36",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
