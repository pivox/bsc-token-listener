# --- Réseau / RPC ---
BSC_NETWORK=mainnet
BSC_HTTP_URLS=https://bsc-mainnet.nodereal.io/v1/VOTRE_CLE
BSC_WSS_URLS=wss://bsc-mainnet.nodereal.io/ws/v1/VOTRE_CLE
# Endpoint d'envoi rapide facultatif (ex. Chainstack Warp). À défaut: premier HTTP ci-dessus.
BSC_TX_HTTP_URL=

# --- Mode d'exécution ---
# dry-run n'envoie aucune transaction. live exige PRIVATE_KEY et SAFETY_PROBE_ADDRESS.
EXECUTION_MODE=dry-run
PRIVATE_KEY=
# Adresse publique BSC suffisamment financée utilisée comme `from` pour eth_call en dry-run.
# Nécessaire pour exécuter SafetyProbe sans PRIVATE_KEY.
SIMULATION_ACCOUNT=

# --- Stratégie ---
BUY_AMOUNT_BNB=0.01
TARGET_BUYS_AFTER_ENTRY=10
BUY_SLIPPAGE_BPS=2500
SELL_SLIPPAGE_BPS=3500
TX_DEADLINE_SECONDS=90
MIN_WBNB_LIQUIDITY=1
MAX_CONCURRENT_POSITIONS=1
PAIR_WAIT_FIRST_BUY_SECONDS=300
MAX_ACTIVE_PAIR_MONITORS=50
EVENT_BACKFILL_BLOCKS=200
EVENT_BACKFILL_CHUNK_SIZE=50
# Rattrapage HTTP périodique si le WebSocket devient silencieux.
EVENT_RECONCILE_SECONDS=15

# --- Sonde achat/revente ---
# Le contrat SafetyProbe doit être déployé une fois. En live, il est obligatoire par défaut.
REQUIRE_SAFETY_PROBE=true
SAFETY_PROBE_ADDRESS=
MAX_ROUND_TRIP_LOSS_BPS=3500

# --- Détection directe de contrats (optionnelle et plus coûteuse en RPC) ---
ENABLE_DIRECT_DEPLOYMENT_LISTENER=false

# --- Persistance ---
# memory pour tester rapidement; postgres recommandé pour reprendre après redémarrage.
STORAGE_DRIVER=memory
DATABASE_URL=postgresql://bscbot:bscbot@127.0.0.1:5439/bscbot
POSTGRES_AUTO_MIGRATE=true

# --- Journalisation ---
LOG_LEVEL=info
