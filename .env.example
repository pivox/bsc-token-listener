# Réseau
BSC_NETWORK=mainnet
BSC_HTTP_RPC_URL=https://bsc-mainnet.nodereal.io/v1/CHANGE_ME
BSC_WS_RPC_URL=wss://bsc-mainnet.nodereal.io/ws/v1/CHANGE_ME

# PancakeSwap V2 BSC mainnet
PANCAKE_FACTORY_ADDRESS=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
PANCAKE_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# PostgreSQL
DATABASE_URL=postgresql://bscbot:bscbot@127.0.0.1:5432/bscbot
POSTGRES_AUTO_MIGRATE=true

# Dashboard local. Les réglages et actions sont disponibles uniquement en écoute loopback.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_REFRESH_SECONDS=5
DASHBOARD_MAX_ROWS=250
# Désactivé par défaut. En live, la confirmation exacte ci-dessous est aussi obligatoire.
DASHBOARD_ACTIONS_ENABLED=false
CONFIRM_DASHBOARD_TRADING_ACTIONS=

# Exécution
EXECUTION_MODE=dry-run
PRIVATE_KEY=
CONFIRM_LIVE_TRADING=
BUY_AMOUNT_BNB=0.01
SLIPPAGE_BPS=1500
TX_DEADLINE_SECONDS=90
TARGET_BUYS_AFTER_ENTRY=3
ENTRY_OBSERVATION_BUYS=3
MAX_CONCURRENT_POSITIONS=1
MAX_ACTIVE_PAIR_MONITORS=50
PAIR_MONITOR_TTL_MINUTES=90
RECONCILE_SECONDS=15

# Risque : allow-only bloque REVIEW et BLOCK. block-only ne bloque que BLOCK.
RISK_POLICY=allow-only
RISK_MIN_SCORE=80
# Valeurs initiales utilisées tant qu'aucun réglage n'est enregistré depuis le dashboard.
# Même si cette option est activée, les WARN et les FAIL restent refusés.
RISK_ALLOW_UNKNOWN_REVIEWS=false
RISK_ALLOW_UNKNOWN_MIN_SCORE=95
MIN_WBNB_LIQUIDITY=0.25
RISK_PROBE_REQUIRED=true
SAFETY_PROBE_ADDRESS=
RISK_PROBE_CALLER=
RISK_PROBE_AMOUNT_BNB=0.005
RISK_MAX_BUY_TAX_BPS=1500
RISK_MAX_SELL_TAX_BPS=1500
RISK_MAX_ROUNDTRIP_LOSS_BPS=3000

# Déploiement du SafetyProbe
CONFIRM_PROBE_DEPLOYMENT=
